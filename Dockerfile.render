# Small-memory image for free hosting (Render free plan: 512 MB RAM).
# Same app, but embeddings run on ONNX Runtime (fastembed) instead of PyTorch.

# ---- 1. build the Angular frontend
FROM node:24-slim AS web
ENV NG_CLI_ANALYTICS=false
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npx ng build

# ---- 2. Python API
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    EMBEDDING_BACKEND=fastembed FASTEMBED_CACHE_PATH=/app/.fastembed \
    OMP_NUM_THREADS=1 MALLOC_ARENA_MAX=2
WORKDIR /app

COPY requirements-deploy.txt .
RUN pip install -r requirements-deploy.txt && python -m spacy download en_core_web_sm

COPY . .
COPY --from=web /web/dist ./frontend/dist

# Download the model and pre-compute job embeddings at build time, so the
# slow free-tier CPU only has to embed the uploaded resume at request time.
RUN python -c "from src.pipeline import MatchingPipeline, load_jobs; MatchingPipeline(load_jobs())"

EXPOSE 10000
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-10000}"]
